[Unit]
Description=Headless TCP forwarding server and LAN dashboard
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tcpserver
Group=tcpserver
WorkingDirectory=/opt/tcp-server
EnvironmentFile=/etc/default/tcp-server
ExecStart=/opt/tcp-server/.venv/bin/python -u /opt/tcp-server/main.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
